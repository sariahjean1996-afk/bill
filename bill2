<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Simple Geo Dash</title>
    <style>
        body { 
            margin: 0; 
            background: #1a1a1a; 
            display: flex; 
            flex-direction: column;
            align-items: center; 
            justify-content: center; 
            height: 100vh; 
            color: white;
            font-family: 'Segoe UI', sans-serif;
        }
        canvas { 
            background: #0072ff; 
            border: 4px solid #fff; 
            box-shadow: 0 0 30px rgba(0,0,0,0.5);
            cursor: pointer;
        }
        .instructions { margin-top: 15px; color: #aaa; }
    </style>
</head>
<body>

    <canvas id="gameCanvas"></canvas>
    <div class="instructions">Press <b>SPACE</b> or <b>CLICK</b> to Jump</div>

<script>
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');

canvas.width = 800;
canvas.height = 400;

// Game State
let gameState = "START"; // START, PLAYING, GAMEOVER
let score = 0;
let frameCount = 0;

// Player Object
const player = {
    x: 100,
    y: 310,
    size: 40,
    dy: 0,
    gravity: 0.7,
    jumpForce: -12,
    grounded: false,
    rotation: 0
};

// Obstacles
let spikes = [];

function spawnSpike() {
    spikes.push({
        x: canvas.width,
        y: 350,
        width: 40,
        height: 40
    });
}

function resetGame() {
    player.y = 310;
    player.dy = 0;
    player.rotation = 0;
    spikes = [];
    score = 0;
    frameCount = 0;
    gameState = "PLAYING";
}

function handleInput() {
    if (gameState === "PLAYING") {
        if (player.grounded) {
            player.dy = player.jumpForce;
            player.grounded = false;
        }
    } else {
        resetGame();
    }
}

// Input Listeners
window.addEventListener('keydown', (e) => { if (e.code === 'Space') handleInput(); });
canvas.addEventListener('mousedown', handleInput);

function update() {
    if (gameState !== "PLAYING") return;

    // Apply Gravity
    player.dy += player.gravity;
    player.y += player.dy;

    // Floor Collision
    if (player.y > 350 - player.size) {
        player.y = 350 - player.size;
        player.dy = 0;
        player.grounded = true;
        // Snap rotation to nearest 90 degrees on land
        player.rotation = Math.round(player.rotation / 90) * 90;
    } else {
        // Rotate while jumping
        player.rotation += 4;
    }

    // Spawn Spikes (Roughly every 1.5 - 2 seconds)
    if (frameCount % 100 === 0) {
        spawnSpike();
    }

    // Move Spikes
    for (let i = spikes.length - 1; i >= 0; i--) {
        spikes[i].x -= 6; // Speed

        // Collision Check (AABB)
        if (
            player.x < spikes[i].x + spikes[i].width - 5 &&
            player.x + player.size > spikes[i].x + 5 &&
            player.y < spikes[i].y + spikes[i].height &&
            player.y + player.size > spikes[i].y
        ) {
            gameState = "GAMEOVER";
        }

        // Remove off-screen spikes
        if (spikes[i].x + spikes[i].width < 0) {
            spikes.splice(i, 1);
            score++;
        }
    }

    frameCount++;
}

function draw() {
    // Clear Canvas
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    // Draw Floor
    ctx.fillStyle = '#222';
    ctx.fillRect(0, 350, canvas.width, 50);

    // Draw Player
    ctx.save();
    ctx.translate(player.x + player.size/2, player.y + player.size/2);
    ctx.rotate(player.rotation * Math.PI / 180);
    ctx.fillStyle = '#FFD700'; // Gold Color
    ctx.fillRect(-player.size/2, -player.size/2, player.size, player.size);
    ctx.strokeStyle = 'black';
    ctx.lineWidth = 2;
    ctx.strokeRect(-player.size/2, -player.size/2, player.size, player.size);
    ctx.restore();

    // Draw Spikes
    ctx.fillStyle = '#ff3e3e';
    spikes.forEach(s => {
        ctx.beginPath();
        ctx.moveTo(s.x, s.y);
        ctx.lineTo(s.x + s.width / 2, s.y - s.height); // Pointy top
        ctx.lineTo(s.x + s.width, s.y);
        ctx.fill();
    });

    // Score UI
    ctx.fillStyle = "white";
    ctx.font = "bold 24px Arial";
    ctx.fillText(`Score: ${score}`, 20, 40);

    if (gameState === "START") {
        ctx.fillStyle = "rgba(0,0,0,0.5)";
        ctx.fillRect(0,0,canvas.width, canvas.height);
        ctx.fillStyle = "white";
        ctx.textAlign = "center";
        ctx.fillText("CLICK TO START", canvas.width/2, canvas.height/2);
    }

    if (gameState === "GAMEOVER") {
        ctx.fillStyle = "rgba(255,0,0,0.4)";
        ctx.fillRect(0,0,canvas.width, canvas.height);
        ctx.fillStyle = "white";
        ctx.textAlign = "center";
        ctx.font = "bold 40px Arial";
        ctx.fillText("CRASHED!", canvas.width/2, canvas.height/2 - 20);
        ctx.font = "20px Arial";
        ctx.fillText("Click to Try Again", canvas.width/2, canvas.height/2 + 20);
    }
}

function gameLoop() {
    update();
    draw();
    requestAnimationFrame(gameLoop);
}

gameLoop();
</script>
</body>
</html>
